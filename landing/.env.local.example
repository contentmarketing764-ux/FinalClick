# n8n orchestrator webhook (Layer 2)
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/lead
N8N_SECRET=replace-with-64-char-random-string

# Cloudflare Turnstile (form anti-bot)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis (rate limit + phone dedupe). Leave blank to disable in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public company name shown in TCPA consent copy + hero
NEXT_PUBLIC_COMPANY_NAME=FinalClick
